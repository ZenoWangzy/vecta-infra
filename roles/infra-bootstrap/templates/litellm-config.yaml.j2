# Managed by Ansible — do not edit on server directly.
# Legacy aliases retain caller compatibility; all use GLM subscription first.
model_list:
  - model_name: glm-5.3-flash
    litellm_params:
      model: openai/glm-5.3-flash
      # #1937 founder ruling: thinking on at high (not max) by default, streamed to the chat.
      # A request-level extra_body replaces this one, e.g. Hermes' photo pre-analysis
      # sends thinking disabled to stay fast.
      extra_body: &glm_thinking_high
        thinking:
          type: enabled
        reasoning_effort: high
      api_key: os.environ/ZAI_API_KEY
      api_base: https://open.bigmodel.cn/api/coding/paas/v4

  - model_name: glm-5
    litellm_params:
      model: openai/glm-5.3-flash
      extra_body: *glm_thinking_high
      api_key: os.environ/ZAI_API_KEY
      api_base: https://open.bigmodel.cn/api/coding/paas/v4

  - model_name: glm-5.1
    litellm_params:
      model: openai/glm-5.3-flash
      extra_body: *glm_thinking_high
      api_key: os.environ/ZAI_API_KEY
      api_base: https://open.bigmodel.cn/api/coding/paas/v4

  - model_name: deepseek-chat
    litellm_params:
      model: openai/glm-5.3-flash
      extra_body: *glm_thinking_high
      api_key: os.environ/ZAI_API_KEY
      api_base: https://open.bigmodel.cn/api/coding/paas/v4

  - model_name: deepseek-v4-flash-vision-exp
    litellm_params:
      model: openai/glm-5.3-flash
      extra_body: *glm_thinking_high
      api_key: os.environ/ZAI_API_KEY
      api_base: https://open.bigmodel.cn/api/coding/paas/v4

  - model_name: multimodal-vision
    litellm_params:
      model: openai/glm-5.3-flash
      extra_body: *glm_thinking_high
      api_key: os.environ/ZAI_API_KEY
      api_base: https://open.bigmodel.cn/api/coding/paas/v4

  # 2026-10-09 founder: all VectA tokens go through the GLM coding plan; this legacy
  # name is one more GLM alias. Paid DeepSeek is reachable only as the fallback below.
  - model_name: deepseek-flash
    litellm_params:
      model: openai/glm-5.3-flash
      extra_body: *glm_thinking_high
      api_key: os.environ/ZAI_API_KEY
      api_base: https://open.bigmodel.cn/api/coding/paas/v4

  # 2026-10-09 founder: 「vecta生产环境的llm还是都用glm的coding plan cn.用尽就fullback到dpsk flash」.
  # Never a caller-facing name: reached only through router_settings.fallbacks.
  - model_name: dpsk-flash-fallback
    litellm_params:
      model: openai/deepseek-flash
      extra_body: *glm_thinking_high
      api_key: os.environ/DEEPSEEK_API_KEY
      api_base: https://api.deepseek.com

router_settings:
  routing: "simple-shuffle"
  num_retries: 1
  # 2026-09-29: founder asked for 10-minute timeouts; a total budget alone let a
  # hung GLM stream hold 「确认撤单」 for 21 min (2x600 s + retry). stream_timeout
  # bounds silence, timeout bounds the whole call (VectA lesson llm-timeout-without-stall-bound).
  timeout: 600
  stream_timeout: 120
  retry_after: 1
  # 2026-10-09: fleet-wide bursts hit the GLM concurrency limit (429, code 1302); the
  # old fallback then sent every call in the 30 s cooldown to paid DeepSeek. Each alias
  # has one deployment, so a cooldown only refuses work: wait and retry GLM instead.
  disable_cooldowns: true
  retry_policy:
    RateLimitErrorRetries: 5
  # A GLM call that still fails after its retries (plan used up) goes to paid DeepSeek
  # flash, one way; the fallback never returns to the subscription.
  fallbacks:
    - glm-5.3-flash: [dpsk-flash-fallback]
    - glm-5: [dpsk-flash-fallback]
    - glm-5.1: [dpsk-flash-fallback]
    - deepseek-chat: [dpsk-flash-fallback]
    - deepseek-v4-flash-vision-exp: [dpsk-flash-fallback]
    - multimodal-vision: [dpsk-flash-fallback]
    - deepseek-flash: [dpsk-flash-fallback]

litellm_settings:
  drop_params: true
